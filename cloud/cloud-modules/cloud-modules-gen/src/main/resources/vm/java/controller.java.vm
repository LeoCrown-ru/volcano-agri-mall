package ${packageName}.controller;

import java.util.List;
import javax.servlet.http.HttpServletResponse;
import com.cloud.common.security.annotation.RequiresPermissions;
import com.cloud.common.log.annotation.Log;
import java.util.Date;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import ${packageName}.domain.${ClassName};
import ${packageName}.service.I${ClassName}Service;
#if($table.crud || $table.sub)
#elseif($table.tree)
#end

/**
 * ${functionName}Controller
 * 
 * @author ${author}
 * @date ${datetime}
 */
@RestController
@RequestMapping("/${moduleName}/${businessName}")
public class ${ClassName}Controller extends BaseController {
    @Resource
    private I${ClassName}Service ${className}Service;

    /**
     * 查询${functionName}列表
     */
    @RequiresPermissions("@ss.hasPermi('${permissionPrefix}:list')")
    @GetMapping("/list")
#if($table.crud || $table.sub)
    public TableDataInfo list(${ClassName} ${className}) {
        startPage();
        LambdaQueryWrapper<${ClassName}> queryWrapper = new LambdaQueryWrapper<>(${className});
        queryWrapper.orderByDesc(${ClassName}::getUpdateTime);
        List<${ClassName}> list = ${className}Service.list(queryWrapper);
        return getDataTable(list);
    }
#elseif($table.tree)
    public AjaxResultResponse<List<${ClassName}>> list(${ClassName} ${className}) {
        LambdaQueryWrapper<${ClassName}> queryWrapper = new LambdaQueryWrapper<>(${className});
        queryWrapper.orderByDesc(${ClassName}::getUpdateTime);
        List<${ClassName}> list = ${className}Service.list(queryWrapper);
        return success(list);
    }
#end

    /**
     * 导出${functionName}列表
     */
    @RequiresPermissions("@ss.hasPermi('${permissionPrefix}:export')")
    @Log(title = "${functionName}", businessType = BusinessType.EXPORT)
    @PostMapping("/export")
    public void export(HttpServletResponse response, ${ClassName} ${className}) {
        LambdaQueryWrapper<${ClassName}> queryWrapper = new LambdaQueryWrapper<>(${className});
        queryWrapper.orderByDesc(${ClassName}::getUpdateTime);
        List<${ClassName}> list = ${className}Service.list(queryWrapper);
        ExcelUtil<${ClassName}> util = new ExcelUtil<${ClassName}>(${ClassName}.class);
        util.exportExcel(response, list, "${functionName}数据");
    }

    /**
     * 获取${functionName}详细信息
     */
    @RequiresPermissions("@ss.hasPermi('${permissionPrefix}:query')")
    @GetMapping(value = "/{${pkColumn.javaField}}")
    public AjaxResultResponse<${ClassName}> getInfo(@PathVariable("${pkColumn.javaField}") ${pkColumn.javaType} ${pkColumn.javaField}) {
        return AjaxResultResponse.success(${className}Service.getById(${pkColumn.javaField}));
    }

    /**
     * 新增${functionName}
     */
    @RequiresPermissions("@ss.hasPermi('${permissionPrefix}:add')")
    @Log(title = "${functionName}", businessType = BusinessType.INSERT)
    @PostMapping
    public AjaxResultResponse<Boolean> add(@RequestBody ${ClassName} ${className}) {
        Date date = new Date();
        ${className}.setCreateTime(date);
        ${className}.setUpdateTime(date);
        return AjaxResultResponse.success(${className}Service.save(${className}));
    }

    /**
     * 修改${functionName}
     */
    @RequiresPermissions("@ss.hasPermi('${permissionPrefix}:edit')")
    @Log(title = "${functionName}", businessType = BusinessType.UPDATE)
    @PutMapping
    public AjaxResultResponse<Boolean> edit(@RequestBody ${ClassName} ${className}) {
        ${className}.setUpdateTime(new Date());
        return AjaxResultResponse.success(${className}Service.updateById(${className}));
    }

    /**
     * 删除${functionName}
     */
    @RequiresPermissions("@ss.hasPermi('${permissionPrefix}:remove')")
    @Log(title = "${functionName}", businessType = BusinessType.DELETE)
	@DeleteMapping("/{${pkColumn.javaField}s}")
    public AjaxResultResponse<Boolean> remove(@PathVariable List<${pkColumn.javaType}> ${pkColumn.javaField}s) {
        return AjaxResultResponse.success((${className}Service.removeBatchByIds(${pkColumn.javaField}s)));
    }
}
